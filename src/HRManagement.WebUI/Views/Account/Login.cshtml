@model HRManagement.WebUI.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    // Login kenar çubuğunu göstermez: henüz kimlik yokken menü anlamsız.
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş Yap — HepiyiHR</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&display=swap" rel="stylesheet" />
    @* Marka dili tek kaynaktan gelsin diye site.css burada da yükleniyor;
       sayfaya özel olan yalnızca ortalama düzeni ve zemin. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Beyaz ağırlıklı zemin: krem→beyaz taban, köşelerde gül ve nane parıltısı. */
        body {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: radial-gradient(900px 520px at 12% -8%, #ffe6ec 0%, transparent 62%),
                        radial-gradient(760px 460px at 92% 108%, #e2f6f2 0%, transparent 60%),
                        linear-gradient(160deg, #fffdf4 0%, #fcfcfc 100%);
        }

        .login-card {
            width: 100%;
            max-width: 404px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 34px 32px 30px;
            box-shadow: 0 24px 60px -30px rgba(35, 37, 43, .28);
        }

        .login-brand { display: flex; align-items: center; gap: 11px; margin-bottom: 26px; }
        .login-brand .brand-text { font-size: 17px; color: var(--ink); }

        .login-card h1 { font-size: 21px; font-weight: 800; letter-spacing: -.5px; margin-bottom: 5px; }
        .login-sub { font-size: 13px; color: var(--muted-3); font-weight: 500; margin: 0 0 24px; }

        .login-fields { display: flex; flex-direction: column; gap: 16px; }
        .login-foot { margin-top: 22px; font-size: 12px; color: var(--muted-4); text-align: center; font-weight: 550; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand">
            <span class="brand-mark">HR</span>
            <span class="brand-text">HepiyiHR</span>
        </div>

        <h1>Giriş Yap</h1>
        <p class="login-sub">Devam etmek için hesabınızla oturum açın.</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly"></div>

            <div class="login-fields">
                <div class="field">
                    <label class="field-label" asp-for="UsernameOrEmail"></label>
                    <input asp-for="UsernameOrEmail" class="input" autocomplete="username" autofocus />
                    <span asp-validation-for="UsernameOrEmail"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Password"></label>
                    <input asp-for="Password" class="input" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <label class="check">
                    <input asp-for="RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
                </label>

                <button type="submit" class="btn btn-primary btn-lg btn-block">Giriş Yap</button>
            </div>
        </form>

        <div class="login-foot">Hesabınız yoksa İK ile iletişime geçin.</div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
