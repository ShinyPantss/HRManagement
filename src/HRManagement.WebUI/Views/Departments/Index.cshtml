@model List<HRManagement.WebUI.Models.Departments.DepartmentCardViewModel>
@{
    ViewData["Title"] = "Departmanlar";

    var totalActive = Model.Sum(d => d.ActiveCount);
    var totalUnits = Model.Sum(d => d.UnitCount);
    var totalInterns = Model.Sum(d => d.InternCount);

    ViewData["Subtitle"] = $"{Model.Count} departman · {totalActive} aktif çalışan · {totalUnits} birim.";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        Departman ekle
    </a>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty-title">Henüz departman kaydı yok</div>
            <div class="empty-text">Sağ üstteki “Departman ekle” ile ilk kaydı açabilirsin.</div>
        </div>
    </div>
}
else
{
    <div class="grid g-4">
        <div class="stat">
            <div class="stat-label">DEPARTMAN</div>
            <div class="stat-row"><span class="stat-value">@Model.Count</span><span class="stat-unit">adet</span></div>
        </div>
        <div class="stat">
            <div class="stat-label">AKTİF ÇALIŞAN</div>
            <div class="stat-row"><span class="stat-value">@totalActive</span><span class="stat-unit">kişi</span></div>
        </div>
        <div class="stat">
            <div class="stat-label">BİRİM</div>
            <div class="stat-row"><span class="stat-value">@totalUnits</span><span class="stat-unit">adet</span></div>
        </div>
        <div class="stat">
            <div class="stat-label">STAJYER</div>
            <div class="stat-row"><span class="stat-value">@totalInterns</span><span class="stat-unit">kişi</span></div>
        </div>
    </div>

    <div class="grid g-3">
        @foreach (var d in Model)
        {
            var passive = d.TotalCount - d.ActiveCount;

            <section class="card card-pad" style="display: flex; flex-direction: column; gap: 15px;">
                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <span class="kpi-icon" style="width: 36px; height: 36px; flex: 0 0 36px; border-radius: var(--r-md);">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 21V8l8-5 8 5v13M9 21v-6h6v6" /></svg>
                    </span>
                    <div class="flex-1" style="min-width: 0;">
                        <div class="row-tight">
                            <span style="font-size: 14px; font-weight: 700; letter-spacing: -.2px; line-height: 1.3;">@d.Name</span>
                            @if (passive > 0)
                            {
                                <span class="badge badge-sm badge-neutral">@passive pasif</span>
                            }
                        </div>
                        <div class="dt-secondary" style="margin-top: 2px;">
                            Yönetici: @(d.ManagerName ?? "atanmadı")
                        </div>
                    </div>
                </div>

                @* Tasarımdaki üçlü sayaç. "İzinde" ve "bekleyen" yerine BİRİM ve
                   STAJYER var: izin uçları departman bilgisi taşımadığı için o iki
                   metrik departman bazında güvenilir üretilemiyor. *@
                <div class="grid g-3" style="gap: 10px;">
                    <div>
                        <div class="mini-stat-value">@d.ActiveCount</div>
                        <div class="mini-stat-label" style="margin: 4px 0 0;">ÇALIŞAN</div>
                    </div>
                    <div>
                        <div class="mini-stat-value text-accent">@d.UnitCount</div>
                        <div class="mini-stat-label" style="margin: 4px 0 0;">BİRİM</div>
                    </div>
                    <div>
                        <div class="mini-stat-value">@d.InternCount</div>
                        <div class="mini-stat-label" style="margin: 4px 0 0;">STAJYER</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(d.Description))
                {
                    <div class="dt-secondary" style="line-height: 1.55;">@d.Description</div>
                }

                <div class="task-actions mt-auto" style="justify-content: flex-start;">
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-md flex-1">Çalışanları gör</a>
                    <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-md">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@d.Id" method="post" style="display: inline;"
                          data-confirm="@($"“{d.Name}” departmanı silinsin mi? Bağlı çalışan veya birim varsa API işlemi reddeder.")"
                          data-confirm-ok="Sil" data-danger>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-md btn-danger">Sil</button>
                    </form>
                </div>
            </section>
        }
    </div>
}
