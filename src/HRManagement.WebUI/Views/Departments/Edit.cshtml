@model HRManagement.WebUI.Models.Departments.DepartmentFormViewModel
@{
    ViewData["Title"] = $"{Model.Name} · Düzenle";
    ViewData["Subtitle"] = $"#{Model.Id} numaralı departman kaydı.";
    ViewData["Crumb"] = "Departmanlar";
    ViewData["CrumbUrl"] = Url.Action("Index", "Departments");
}

<div class="card card-pad-lg narrow">
    <form asp-action="Edit" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Id" />

        <div class="stack">
            <div class="field">
                <label class="field-label" asp-for="Name"></label>
                <input asp-for="Name" class="input" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="field">
                <label class="field-label" asp-for="Description"></label>
                <textarea asp-for="Description" class="textarea" rows="3"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
        </div>

        <div class="form-actions" style="margin-top: 22px;">
            <button type="submit" class="btn btn-primary btn-lg">Güncelle</button>
            <a asp-action="Index" class="btn btn-lg">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
