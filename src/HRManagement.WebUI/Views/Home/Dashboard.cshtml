@using HRManagement.WebUI.Models
@model HRManagement.WebUI.Models.Api.Dashboard.HrDashboardResponse
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Subtitle"] = $"Şirket geneli özet — {Model.TotalActiveEmployees} aktif kayıt üzerinden, {DateTime.Today:dd MMMM yyyy} itibarıyla.";

    // Cinsiyet oranları (sıfıra bölme koruması).
    var genderTotal = Model.MaleCount + Model.FemaleCount + Model.GenderUnspecifiedCount;
    int Pct(int n) => genderTotal == 0 ? 0 : (int)Math.Round(100.0 * n / genderTotal);

    // Uzayabilen listeler pano kartında KESİLİR. Sebebi geçmişte yaşandı: sınırsız
    // liste ile sabit yükseklikli kart yan yana konunca, liste uzadıkça komşusunun
    // altında dev bir boşluk kalıyordu. Pano özet ekranı — tam liste "Tümü"nde.
    const int listLimit = 6;

    var onLeaveShown = Model.OnLeaveNow.Take(listLimit).ToList();
    var onLeaveHidden = Model.OnLeaveNow.Count - onLeaveShown.Count;

    var upcomingShown = Model.UpcomingLeaves.Take(listLimit).ToList();
    var upcomingHidden = Model.UpcomingLeaves.Count - upcomingShown.Count;

    // Trend barları en yoğun aya göre ölçeklenir.
    var maxTrend = Model.MonthlyTrend.Count > 0 ? Model.MonthlyTrend.Max(t => t.WorkingDays) : 0;

    // Kıdem piramidi: en kalabalık kademeye göre.
    var maxSeniority = Model.SeniorityBreakdown.Count > 0 ? Model.SeniorityBreakdown.Max(s => s.Count) : 0;

    // Halka grafik: dilimler kümülatif yüzdelerle conic-gradient'e çevrilir.
    var slices = new[]
    {
        (Label: "Erkek",        Count: Model.MaleCount,             Color: "#977ef9"),
        (Label: "Kadın",        Count: Model.FemaleCount,           Color: "#99e1d9"),
        (Label: "Belirtilmemiş",Count: Model.GenderUnspecifiedCount,Color: "#d9dce3"),
    }.Where(s => s.Count > 0).ToList();

    string DonutGradient()
    {
        if (genderTotal == 0) return "var(--track)";
        var acc = 0.0;
        var stops = slices.Select(s =>
        {
            var v = 100.0 * s.Count / genderTotal;
            var stop = string.Format(System.Globalization.CultureInfo.InvariantCulture,
                "{0} {1:0.##}% {2:0.##}%", s.Color, acc, acc + v);
            acc += v;
            return stop;
        });
        return $"conic-gradient({string.Join(",", stops)})";
    }
}

@section PageActions {
    <a asp-controller="LeaveRequests" asp-action="Approvals" class="btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 12.5 11.5 15 16 9" /><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
        Onay kutusu
    </a>
    <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        İzin talebi oluştur
    </a>
}

@* ── KPI kartları — tıklayınca ilgili ekrana gider ─────────────────── *@
<div class="grid g-4">
    <a class="kpi" asp-controller="Employees" asp-action="Index">
        <div class="kpi-top">
            <span class="kpi-label">Aktif çalışan</span>
            <span class="kpi-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M2.5 20a6.5 6.5 0 0 1 13 0M17 5.5a3 3 0 0 1 0 6" /></svg>
            </span>
        </div>
        <div class="kpi-value-row">
            <span class="kpi-value">@Model.TotalActiveEmployees</span>
            <span class="kpi-unit">kişi</span>
        </div>
        <div class="kpi-note-row">
            @if (Model.EmployeesWithoutAccount > 0)
            {
                <span class="badge badge-sm badge-warn">@Model.EmployeesWithoutAccount hesapsız</span>
                <span class="kpi-note">giriş açılmalı</span>
            }
            else
            {
                <span class="badge badge-sm badge-ok">tam</span>
                <span class="kpi-note">herkesin hesabı var</span>
            }
        </div>
    </a>

    <a class="kpi" asp-controller="LeaveRequests" asp-action="Index">
        <div class="kpi-top">
            <span class="kpi-label">Şu an izinde</span>
            <span class="kpi-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2v4M16 2v4M3 10h18" /><rect x="3" y="6" width="18" height="16" rx="2.5" /></svg>
            </span>
        </div>
        <div class="kpi-value-row">
            <span class="kpi-value">@Model.OnLeaveNowCount</span>
            <span class="kpi-unit">kişi</span>
        </div>
        <div class="kpi-note-row">
            <span class="badge badge-sm badge-brand">
                %@(Model.TotalActiveEmployees == 0 ? 0 : Math.Round(100.0 * Model.OnLeaveNowCount / Model.TotalActiveEmployees, 1))
            </span>
            <span class="kpi-note">kadronun oranı</span>
        </div>
    </a>

    <a class="kpi" asp-controller="LeaveRequests" asp-action="Approvals">
        <div class="kpi-top">
            <span class="kpi-label">Onay bekleyen</span>
            <span class="kpi-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 7v5l3 2" /><circle cx="12" cy="12" r="9" /></svg>
            </span>
        </div>
        <div class="kpi-value-row">
            <span class="kpi-value">@Model.PendingLeaveRequests</span>
            <span class="kpi-unit">talep</span>
        </div>
        <div class="kpi-note-row">
            @if (Model.OverduePendingCount > 0)
            {
                @* Sayı değil GECİKME vurgulanır: 20 talebin hepsi dünden ise sorun yok,
                   1 talep 9 gündür bekliyorsa sorun var. *@
                <span class="badge badge-sm badge-danger">@Model.OverduePendingCount gecikmiş</span>
                <span class="kpi-note">en eskisi @Model.OldestPendingDays gündür bekliyor</span>
            }
            else if (Model.PendingLeaveRequests > 0)
            {
                <span class="badge badge-sm badge-warn">işlem bekliyor</span>
                <span class="kpi-note">hepsi @Model.OverdueThresholdDays günden yeni</span>
            }
            else
            {
                <span class="badge badge-sm badge-ok">temiz</span>
                <span class="kpi-note">bekleyen talep yok</span>
            }
        </div>
    </a>

    <a class="kpi" asp-controller="Interns" asp-action="Index">
        <div class="kpi-top">
            <span class="kpi-label">Aktif stajyer</span>
            <span class="kpi-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3 3 8l9 5 9-5zM3 13l9 5 9-5" /></svg>
            </span>
        </div>
        <div class="kpi-value-row">
            <span class="kpi-value">@Model.ActiveInterns</span>
            <span class="kpi-unit">kişi</span>
        </div>
        <div class="kpi-note-row">
            @if (Model.InternsEndingSoon > 0)
            {
                <span class="badge badge-sm badge-warn">@Model.InternsEndingSoon bitiyor</span>
                <span class="kpi-note">@Model.InternEndingWindowDays gün içinde</span>
            }
            else
            {
                <span class="badge badge-sm badge-violet">mentorluk</span>
                <span class="kpi-note">yakın zamanda biten yok</span>
            }
        </div>
    </a>
</div>

@* ── 1. satır: iki izin listesi yan yana ────────────────────────────
   align-items: start — kartlar birbirini uzatmasın. Grid'in varsayılan
   stretch davranışı, yanındaki uzun listeye eşitlenen boş kartlar üretiyordu.
   Her iki liste de 6 satırda kesildiği için ikisi de sınırsız uzayamaz. *@
<div class="grid g-2" style="align-items: start;">
    <section class="card card-flush">
        <div class="card-head">
            <div class="row-tight">
                <h2>Şu an izinde olanlar</h2>
                <span class="badge badge-sm badge-brand">@Model.OnLeaveNow.Count</span>
            </div>
            <a class="card-head-link" asp-controller="LeaveRequests" asp-action="Index">Tümü</a>
        </div>

        @if (onLeaveShown.Count > 0)
        {
            <div class="dt" style="--cols: 1.6fr 1fr 1.2fr;">
                <div class="dt-head">
                    <span>Kişi</span><span>İzin türü</span><span class="text-right">Dönüş</span>
                </div>
                @for (var i = 0; i < onLeaveShown.Count; i++)
                {
                    var p = onLeaveShown[i];
                    <div class="dt-row">
                        <div class="person">
                            <span class="avatar avatar-sm av-@(i % 6 + 1)">@Init(p.SubjectName)</span>
                            <div class="person-text">
                                <div class="dt-primary">@p.SubjectName</div>
                                <div class="dt-secondary">@p.SubjectType</div>
                            </div>
                        </div>
                        <span><span class="badge badge-sm @LeaveDisplay.TypeBadge(p.TypeName)">@LeaveDisplay.TypeText(p.TypeName)</span></span>
                        <span class="dt-cell-muted text-right num">@p.EndDate.ToString("dd MMM")</span>
                    </div>
                }
            </div>

            @if (onLeaveHidden > 0)
            {
                <a class="dt-row dt-row-more" asp-controller="LeaveRequests" asp-action="Index">
                    <span class="dt-secondary">@onLeaveHidden kişi daha izinde — tümünü gör</span>
                </a>
            }
        }
        else
        {
            <div class="empty">
                <div class="empty-title">Bugün herkes ofiste</div>
                <div class="empty-text">Şu an izinde olan kimse yok.</div>
            </div>
        }
    </section>

    <section class="card card-flush">
        <div class="card-head">
            <div class="row-tight">
                <h2>Yaklaşan izinler</h2>
                <span class="badge badge-sm badge-brand">@Model.UpcomingLeaves.Count</span>
            </div>
            <span class="card-head-meta">önümüzdeki @Model.UpcomingWindowDays gün</span>
        </div>

        @if (upcomingShown.Count > 0)
        {
            <div class="dt" style="--cols: 1.6fr 1fr .8fr 1fr;">
                <div class="dt-head">
                    <span>Kişi</span><span>İzin türü</span><span class="text-right">Gün</span><span class="text-right">Başlıyor</span>
                </div>
                @for (var i = 0; i < upcomingShown.Count; i++)
                {
                    var p = upcomingShown[i];
                    <div class="dt-row">
                        <div class="person">
                            <span class="avatar avatar-sm av-@(i % 6 + 1)">@Init(p.SubjectName)</span>
                            <div class="person-text">
                                <div class="dt-primary">@p.SubjectName</div>
                                <div class="dt-secondary">@p.StartDate.ToString("dd MMM") – @p.EndDate.ToString("dd MMM")</div>
                            </div>
                        </div>
                        <span><span class="badge badge-sm @LeaveDisplay.TypeBadge(p.TypeName)">@LeaveDisplay.TypeText(p.TypeName)</span></span>
                        <span class="dt-strong text-right">@p.WorkingDays</span>
                        <span class="dt-cell-muted text-right">
                            @(p.DaysUntilStart == 1 ? "yarın" : $"{p.DaysUntilStart} gün sonra")
                        </span>
                    </div>
                }
            </div>

            @if (upcomingHidden > 0)
            {
                <a class="dt-row dt-row-more" asp-controller="LeaveRequests" asp-action="Index">
                    <span class="dt-secondary">@upcomingHidden izin daha — tümünü gör</span>
                </a>
            }
        }
        else
        {
            <div class="empty">
                <div class="empty-title">Yaklaşan izin yok</div>
                <div class="empty-text">Önümüzdeki @Model.UpcomingWindowDays gün için onaylı izin görünmüyor.</div>
            </div>
        }
    </section>
</div>

@* ── 2. satır: izin trendi (3 birim) | kadro yapısı (1 birim) ────────
   Burada align-items: start YOK — bilerek. 1. satırdaki listeler veriye göre
   uzayabildiği için orada gerekliydi; buradaki iki kartın içeriği ise sabit
   sayıda satır (6 ay / 6 kıdem kademesi). Dolayısıyla stretch güvenli ve
   kartların altları hizalanıyor. Trend kartı içeriğini dikey yayarak boşluğu
   barlar arasına dağıtıyor, alta yığmıyor. *@
<div class="grid g-3-1">

    @* ── Son 6 ay izin trendi — geniş sütun ──────────────────────────────
       KOŞULSUZ render ediliyor: grid hücresini @@if içine almak, veri
       gelmediğinde hücreyi tamamen yok eder; yanındaki kart 3fr'lik sütuna
       kayar ve satır yarım görünür. Boş durum kartın İÇİNDE ele alınmalı. *@
    <section class="card card-pad" style="display: flex; flex-direction: column;">
        <div class="row-between" style="margin-bottom: 16px;">
            <h2 class="section-title" style="margin-bottom: 0;">
                @(Model.MonthlyTrend.Count > 0
                    ? $"Son {Model.MonthlyTrend.Count} ay izin kullanımı"
                    : "İzin kullanımı")
            </h2>
            <span class="card-head-meta">@Model.MonthlyTrend.Sum(t => t.WorkingDays) iş günü</span>
        </div>

        @if (maxTrend == 0)
        {
            <div class="empty">
                <div class="empty-title">Gösterilecek trend yok</div>
                <div class="empty-text">Bu dönemde onaylanmış izin bulunmuyor.</div>
            </div>
        }
        else
        {
            @* flex:1 + space-between → kart komşusunun boyuna uzadığında fazla
               alan barların ARASINA dağılır; altta tek parça boşluk kalmaz. *@
            <div class="stack" style="gap: 13px; flex: 1; justify-content: space-between;">
                @foreach (var t in Model.MonthlyTrend)
                {
                    var width = (int)Math.Round(100.0 * t.WorkingDays / maxTrend);
                    var isPeak = t.WorkingDays == maxTrend;
                    var label = new DateTime(t.Year, t.Month, 1).ToString("MMMM yyyy");
                    <div class="bar-row">
                        <span class="bar-name">@label</span>
                        <span class="bar-value">@t.WorkingDays gün · @t.RequestCount talep</span>
                        <div class="bar bar-lg"><div class="bar-fill @(isPeak ? "" : "sky")" style="width: @width%;"></div></div>
                    </div>
                }
            </div>
            <div class="mini-stat-label" style="margin-top: 16px;">
                Yalnızca onaylanmış izinler; izin BAŞLANGIÇ ayına yazılır. İş günü esaslıdır.
            </div>
        }
    </section>

    @* ── Kadro: cinsiyet + kıdem — dar sütun ─────────────────────────
       Donut 108px sabit genişlikte; dar sütunda legend'in yanına sığmaz,
       bu yüzden burada alt alta diziliyorlar. *@
    <section class="card card-pad">
        <h2 class="section-title">Kadro yapısı</h2>

        @if (genderTotal == 0)
        {
            <div class="empty-text">Gösterilecek çalışan yok.</div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; align-items: center; gap: 14px;">
                <div class="donut" style="background: @DonutGradient();">
                    <div class="donut-hole">
                        <div>
                            <div class="donut-value num">@genderTotal</div>
                            <div class="donut-label">çalışan</div>
                        </div>
                    </div>
                </div>
                <div class="legend" style="width: 100%;">
                    <div class="legend-row">
                        <span class="legend-dot" style="background: #977ef9;"></span>
                        <span class="legend-name">Erkek</span>
                        <span class="legend-value">@Model.MaleCount · %@Pct(Model.MaleCount)</span>
                    </div>
                    <div class="legend-row">
                        <span class="legend-dot" style="background: #99e1d9;"></span>
                        <span class="legend-name">Kadın</span>
                        <span class="legend-value">@Model.FemaleCount · %@Pct(Model.FemaleCount)</span>
                    </div>
                    @if (Model.GenderUnspecifiedCount > 0)
                    {
                        <div class="legend-row">
                            <span class="legend-dot" style="background: #d9dce3;"></span>
                            <span class="legend-name">Belirtilmemiş</span>
                            <span class="legend-value">@Model.GenderUnspecifiedCount · %@Pct(Model.GenderUnspecifiedCount)</span>
                        </div>
                    }
                </div>
            </div>

            @if (Model.SeniorityBreakdown.Count > 0)
            {
                @* Kıdem piramidi: departman dağılımının yerine geçti. Kaç kişi
                   olduğundan çok organizasyonun ŞEKLİNİ gösterir — üstü dar mı,
                   ortası şişkin mi. *@
                <div style="margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line);">
                    <div class="mini-stat-label" style="margin-bottom: 10px;">KIDEM DAĞILIMI</div>
                    <div class="stack" style="gap: 9px;">
                        @foreach (var s in Model.SeniorityBreakdown)
                        {
                            var width = maxSeniority == 0 ? 0 : (int)Math.Round(100.0 * s.Count / maxSeniority);
                            <div class="bar-row">
                                <span class="bar-name">@(s.Seniority is null ? "Belirtilmemiş" : SeniorityDisplay.Label(s.Seniority))</span>
                                <span class="bar-value">@s.Count</span>
                                <div class="bar"><div class="bar-fill @(s.Seniority is null ? "sky" : "")" style="width: @width%;"></div></div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </section>
</div>

@functions {
    // Baş harfler — avatar için ("Elif Yıldırım" → "EY").
    string Init(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            : char.ToUpperInvariant(parts[0][0]).ToString();
    }
}
