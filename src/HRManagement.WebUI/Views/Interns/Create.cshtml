@model HRManagement.WebUI.Models.Interns.InternFormViewModel
@{
    ViewData["Title"] = "Yeni Stajyer";
    ViewData["Subtitle"] = "Mentor ve birim dışındaki alanlar zorunludur.";
    ViewData["Crumb"] = "Stajyerler";
    ViewData["CrumbUrl"] = Url.Action("Index", "Interns");

    // İndeksle atıyoruz, koleksiyon başlatıcısıyla değil: başlatıcı Add() çağırır
    // ve anahtar ViewData'da zaten varsa "duplicate key" hatası verir.
    var formData = new ViewDataDictionary(ViewData);
    formData["IsCreate"] = true;
}

<div class="card card-pad-lg mid">
    <form asp-action="Create" method="post" novalidate>
        <partial name="_InternForm" model="Model" view-data="formData" />

        <div class="form-actions" style="margin-top: 22px;">
            <button type="submit" class="btn btn-primary btn-lg">Kaydet</button>
            <a asp-action="Index" class="btn btn-lg">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_UnitDepartmentFilter" />
    <partial name="_MentorUnitFilter" />
}
