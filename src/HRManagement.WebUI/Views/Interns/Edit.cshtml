@model HRManagement.WebUI.Models.Interns.InternFormViewModel
@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName} · Düzenle";
    ViewData["Subtitle"] = $"#{Model.Id} numaralı stajyer kaydı.";
    ViewData["Crumb"] = "Stajyerler";
    ViewData["CrumbUrl"] = Url.Action("Index", "Interns");

    var formData = new ViewDataDictionary(ViewData);
    formData["IsCreate"] = false;
}

@section PageActions {
    <a asp-controller="Mentorship" asp-action="Detail" asp-route-id="@Model.Id" class="btn">Detayı gör</a>
}

<div class="card card-pad-lg mid">
    <form asp-action="Edit" method="post" novalidate>
        <partial name="_InternForm" model="Model" view-data="formData" />

        <div class="form-actions" style="margin-top: 22px;">
            <button type="submit" class="btn btn-primary btn-lg">Güncelle</button>
            <a asp-action="Index" class="btn btn-lg">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_UnitDepartmentFilter" />
    <partial name="_MentorUnitFilter" />
}
