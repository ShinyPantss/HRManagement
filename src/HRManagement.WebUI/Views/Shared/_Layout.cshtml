@*
    HepiyiHR kabuğu — koyu mor kenar çubuğu + yapışkan üst bar + içerik.
    Tasarım: claude.ai/design → HepiyiHR.dc.html

    View'lardan beklenenler:
      ViewData["Title"]     — h1 ve <title> (zorunlu)
      ViewData["Subtitle"]  — başlık altı açıklama satırı
      ViewData["Crumb"]     — kırıntıdaki ara adım metni (ör. "Çalışanlar")
      ViewData["CrumbUrl"]  — o adımın linki
      section PageActions   — sağ üstteki buton grubu
*@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — HepiyiHR</title>
    @* Değişken eksen (400..800): tasarım 550/650 gibi ara ağırlıklar kullanıyor,
       sabit kesitler bunları yuvarlardı. Yüklenemezse sistem yazı tipine düşer. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var userName = User.Identity?.Name ?? "";
        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        var isAuth = User.Identity?.IsAuthenticated == true;
        // Menüde "Çalışanlar" adı yalnızca İK'da; Manager ve Employee aynı ekranı
        // "Ekibim" olarak görür (API içeriği zaten role göre daraltıyor).
        var employeesLabel = User.IsInRole("HR") ? "Çalışanlar" : "Ekibim";

        // Admin SİSTEM rolüdür: hesap açar, organizasyonu izler, talepleri işler.
        // Personel dosyası / izin / stajyer ekranları İK'nın işidir ve Admin'in
        // menüsünde yer almaz — aksi hâlde menü HR'ın birebir kopyası olurdu.
        // (Bu bir GÖRÜNÜM kararıdır; API'deki yetkiler bilinçli olarak korundu,
        //  Admin adresi elle yazarsa acil durumda müdahale edebilir.)
        var isAdmin = User.IsInRole("Admin");
    }

    <div class="app-shell">

        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">HR</span>
                <span class="brand-text">HepiyiHR</span>
            </a>

            <nav class="sidebar-nav">
                <a class="nav-item @Active("Home")" asp-controller="Home" asp-action="Index">
                    @Icon("M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-7H10v7H5a1 1 0 0 1-1-1z")
                    Ana Sayfa
                </a>

                @* Profilim: kişinin kendi çalışan kaydı. Admin'in çalışan kaydı yok
                   (sistem rolü), Intern'in profili ise Employee değil — ikisine de çıkmaz. *@
                @if (isAuth && !User.IsInRole("Admin") && !User.IsInRole("Intern"))
                {
                    <a class="nav-item @Active2("Employees", "Profile")" asp-controller="Employees" asp-action="Profile">
                        @Icon("M12 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M5 20a7 7 0 0 1 14 0")
                        Profilim
                    </a>
                }

                @* Stajyerin Profilim'i: çalışan profili değil, /api/interns/me'den
                   beslenen kendi ekranı. *@
                @if (User.IsInRole("Intern"))
                {
                    <a class="nav-item @Active("InternProfile")" asp-controller="InternProfile" asp-action="Index">
                        @Icon("M12 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M5 20a7 7 0 0 1 14 0")
                        Profilim
                    </a>
                }

                @* Personel dosyası Admin'in işi değil: kadro haritasına Organizasyon'dan
                   bakar, kişi kartlarına girmez (not yazamaması, çalışan ekleyememesiyle
                   aynı çizgi). *@
                @if (!isAdmin)
                {
                    <a class="nav-item @ActiveExcept("Employees", "Profile")" asp-controller="Employees" asp-action="Index">
                        @Icon("M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M2.5 20a6.5 6.5 0 0 1 13 0M17 5.5a3 3 0 0 1 0 6M21.5 20a6 6 0 0 0-3-5.2")
                        @employeesLabel
                    </a>
                }

                @* Görevlerim: stajyerin mentor tarafından atanan görevleri —
                   Mentorluk ekranının stajyer tarafındaki aynası. *@
                @if (User.IsInRole("Intern"))
                {
                    <a class="nav-item @Active("MyTasks")" asp-controller="MyTasks" asp-action="Index">
                        @Icon("M9 12.5 11.5 15 16 9M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2")
                        Görevlerim
                    </a>
                }

                @* Mentorluk: Manager da Employee da mentor olabilir — kişi yalnızca
                   KENDİ stajyerlerini görür (yetki API'de, ilişkiden). *@
                @if (User.IsInRole("Manager") || User.IsInRole("Employee"))
                {
                    <a class="nav-item @Active("Mentorship")" asp-controller="Mentorship" asp-action="Index">
                        @Icon("M12 3 2 8l10 5 10-5zM6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5")
                        Mentorluk
                    </a>
                }

                @* İzin süreci İK/yönetici işidir; Admin'in ne kendi izni vardır
                   (çalışan kaydı yok) ne de başkasınınkini yönetir. *@
                @if (!isAdmin)
                {
                    <a class="nav-item @ActiveExcept("LeaveRequests", "Approvals", "Calendar")" asp-controller="LeaveRequests" asp-action="Index">
                        @Icon("M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2")
                        @(User.IsInRole("HR") ? "İzin Geçmişi" : "İzinlerim")
                    </a>
                }

                @* Onay Bekleyenler: yalnızca onaylayabilen roller. *@
                @if (User.IsInRole("HR") || User.IsInRole("Manager"))
                {
                    <a class="nav-item @Active2("LeaveRequests", "Approvals")" asp-controller="LeaveRequests" asp-action="Approvals">
                        @Icon("M9 12.5 11.5 15 16 9M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2")
                        Onay Bekleyenler
                    </a>
                }

                @* Ekip İzin Takvimi: yalnızca yönetici — ekranın verisi kişi başına
                   bir çağrıyla toplandığı için kapsamı ekiple sınırlı. *@
                @if (User.IsInRole("Manager"))
                {
                    <a class="nav-item @Active2("LeaveRequests", "Calendar")" asp-controller="LeaveRequests" asp-action="Calendar">
                        @Icon("M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2M8 14h2M14 14h2M8 18h2")
                        İzin Takvimi
                    </a>
                }

                @* Stajyerler (tüm liste) YÖNETİM ekranıdır: yalnızca İK.
                   Manager ve Employee kendi stajyerlerine Mentorluk'tan ulaşır;
                   stajyerin kendisi bu listeyi hiç görmez — onun dünyası
                   Staj Panelim + Profilim + Görevlerim'dir. *@
                @if (User.IsInRole("HR"))
                {
                    <a class="nav-item @Active("Interns")" asp-controller="Interns" asp-action="Index">
                        @Icon("M12 3 2 8l10 5 10-5zM6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5")
                        Stajyerler
                    </a>
                }

                @* Departmanlar YÖNETİM ekranıdır (ekleme/silme) — yalnızca İK.
                   Admin yapıyı Organizasyon'dan salt okunur izler. *@
                @if (User.IsInRole("HR"))
                {
                    <a class="nav-item @Active("Departments")" asp-controller="Departments" asp-action="Index">
                        @Icon("M4 21V8l8-5 8 5v13M9 21v-6h6v6M2 21h20")
                        Departmanlar
                    </a>
                }

                @* Organizasyon HERKESE açık: departman/birim yapısı referans veridir.
                   Kişiler zaten API'de göruş alanına göre daralıyor, ekran da
                   daraltılmış görünümde sayı/yokluk iddiası göstermiyor. *@
                <a class="nav-item @Active("Organization")" asp-controller="Organization" asp-action="Index">
                    @Icon("M12 3v4M5 21v-5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v5M9 7h6v4H9zM3 21h4v-4H3zM17 21h4v-4h-4z")
                    Organizasyon
                </a>

                @* Hesap yönetimi Admin'in ÇEKİRDEK işi: rol atama gücü yalnızca
                   burada durur (HR'a verilseydi HR kendini Admin yapabilirdi). *@
                @if (isAdmin)
                {
                    <a class="nav-item @Active("Users")" asp-controller="Users" asp-action="Index">
                        @Icon("M12 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M5 20a7 7 0 0 1 14 0M17.5 3.5a3 3 0 0 1 0 5")
                        Kullanıcı Hesapları
                    </a>
                }

                @* Yalnızca Admin bekleyen hesap taleplerini işler. *@
                @if (isAdmin)
                {
                    <a class="nav-item @Active2("AccountRequests", "Pending")" asp-controller="AccountRequests" asp-action="Pending">
                        @Icon("M9 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M2.5 20a6.5 6.5 0 0 1 13 0M19 8v6M16 11h6")
                        Bekleyen Talepler
                    </a>
                }
            </nav>

            <div class="sidebar-foot">
                @* İzin talebi kısayolu. Talep açabilecek herkes görür; yalnızca
                   Admin görmez (çalışan kaydı yok). *@
                @if (User.IsInRole("HR") || User.IsInRole("Manager")
                    || User.IsInRole("Employee") || User.IsInRole("Intern"))
                {
                    <a asp-controller="LeaveRequests" asp-action="Create" class="sidebar-cta">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4M16 2v4M3 10h18" /><rect x="3" y="6" width="18" height="15" rx="2.5" /><path d="M12 12.5v5M9.5 15h5" /></svg>
                        İzin Talep Et
                    </a>
                }

                @if (isAuth)
                {
                    <div class="sidebar-user">
                        <span class="sidebar-user-avatar">@Initials(userName)</span>
                        <div class="flex-1">
                            <div class="sidebar-user-name">@userName</div>
                            <div class="sidebar-user-role">@RoleText(userRole)</div>
                        </div>
                        @* Çıkış POST'tur: GET ile olsaydı bir <img src="/Account/Logout"> herkesi atardı (CSRF). *@
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="sidebar-logout" title="Çıkış yap" aria-label="Çıkış yap">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3M16 17l5-5-5-5M21 12H9" /></svg>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Menüyü aç">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>

                @* Sayfadaki [data-search] taşıyan satırları anlık süzer; öyle satır
                   yoksa site.js bu kutuyu gizler (çalışmayan kontrol göstermeyelim). *@
                <div class="topbar-search" id="globalSearchBox" hidden>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9aa0aa" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input type="search" id="globalSearch" placeholder="Bu sayfada ara…" autocomplete="off" aria-label="Sayfa içinde ara" />
                </div>

                <div class="topbar-right">
                    <span class="topbar-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2v4M16 2v4" /><rect x="3" y="6" width="18" height="16" rx="2.5" /></svg>
                        @DateTime.Today.ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                    </span>
                    @if (!isAuth)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-md">Giriş yap</a>
                    }
                </div>
            </header>

            @* Bildirimler sağ üstte belirir, 5 sn sonra kendiliğinden kapanır. *@
            <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true">
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="toast toast-error">
                        <span class="toast-mark"></span>
                        <div class="toast-body">@errorMessage</div>
                        <button type="button" class="toast-close" aria-label="Kapat">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
                        </button>
                    </div>
                }
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="toast toast-ok">
                        <span class="toast-mark"></span>
                        <div class="toast-body">@successMessage</div>
                        <button type="button" class="toast-close" aria-label="Kapat">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
                        </button>
                    </div>
                }
            </div>

            <main class="content">
                <div class="page-head">
                    <div>
                        <div class="crumb">
                            <span>HepiyiHR</span>
                            <span>/</span>
                            @if (ViewData["Crumb"] is string crumbText && !string.IsNullOrWhiteSpace(crumbText))
                            {
                                @if (ViewData["CrumbUrl"] is string crumbUrl && !string.IsNullOrWhiteSpace(crumbUrl))
                                {
                                    <a href="@crumbUrl">@crumbText</a>
                                }
                                else
                                {
                                    <span>@crumbText</span>
                                }
                                <span>/</span>
                            }
                            <span class="crumb-here">@ViewData["Title"]</span>
                        </div>
                        <h1>@ViewData["Title"]</h1>
                        @if (ViewData["Subtitle"] is string subtitle && !string.IsNullOrWhiteSpace(subtitle))
                        {
                            <p class="page-sub">@subtitle</p>
                        }
                    </div>
                    @if (IsSectionDefined("PageActions"))
                    {
                        <div class="page-actions">
                            @await RenderSectionAsync("PageActions", required: false)
                        </div>
                    }
                </div>

                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // Kenar çubuğu ikonu: tasarımdaki 24×24 çizgi ikon seti.
    Microsoft.AspNetCore.Html.IHtmlContent Icon(string path)
    {
        var svg = $"<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" " +
                  $"stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"{path}\"/></svg>";
        return new Microsoft.AspNetCore.Html.HtmlString(svg);
    }

    // Baş harf(ler): "elif.yildirim" → "EY", "admin" → "AD".
    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return (char.ToUpperInvariant(parts[0][0]).ToString() + char.ToUpperInvariant(parts[1][0])).ToString();
        return name.Length >= 2
            ? name.Substring(0, 2).ToUpperInvariant()
            : char.ToUpperInvariant(name[0]).ToString();
    }

    // Rol adının Türkçe karşılığı — claim İngilizce enum adını taşır.
    string RoleText(string role) => role switch
    {
        "Admin" => "Sistem Yöneticisi",
        "HR" => "İnsan Kaynakları",
        "Manager" => "Yönetici",
        "Employee" => "Çalışan",
        "Intern" => "Stajyer",
        _ => role
    };

    // Aktif menü öğesi: geçerli controller adı eşleşiyorsa "active" döner.
    string Active(string controller)
    {
        var current = ViewContext.RouteData.Values["controller"] as string ?? "";
        return current.Equals(controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    // Controller eşleşince aktif, verilen action'lar HARİÇ. Örn. Profilim de
    // Employees controller'ında yaşadığı için "Çalışanlar" menüsü Profile
    // action'ında yanmamalı — o sayfanın menüdeki sahibi Profilim'dir.
    string ActiveExcept(string controller, params string[] excludedActions)
    {
        var c = ViewContext.RouteData.Values["controller"] as string ?? "";
        var a = ViewContext.RouteData.Values["action"] as string ?? "";
        return c.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && !excludedActions.Any(x => x.Equals(a, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
    }

    // Aynı controller altında iki menü öğesi olduğunda (ör. LeaveRequests →
    // Index ve Approvals) action'a göre ayırt eder.
    string Active2(string controller, string action)
    {
        var c = ViewContext.RouteData.Values["controller"] as string ?? "";
        var a = ViewContext.RouteData.Values["action"] as string ?? "";
        return c.Equals(controller, StringComparison.OrdinalIgnoreCase)
            && a.Equals(action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
