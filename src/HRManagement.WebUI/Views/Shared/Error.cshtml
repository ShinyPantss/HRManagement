@model ErrorViewModel
@{
    ViewData["Title"] = "Bir şeyler ters gitti";
    ViewData["Subtitle"] = "İstek işlenirken beklenmeyen bir hata oluştu.";
}

<div class="card card-pad-lg narrow">
    <div style="display: flex; gap: 14px; align-items: flex-start;">
        <span class="kpi-icon" style="background: var(--danger-bg); color: var(--danger); width: 38px; height: 38px; flex: 0 0 38px; border-radius: var(--r-md);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v5M12 16.5h.01" /><circle cx="12" cy="12" r="9" /></svg>
        </span>
        <div class="flex-1">
            <div class="section-title" style="margin-bottom: 6px;">Hata</div>
            <p class="page-sub" style="margin-bottom: 18px;">
                İşleminiz tamamlanamadı. Tekrar denemek için geri dönebilir, sorun sürerse
                aşağıdaki istek numarasıyla birlikte İK'ya bildirebilirsiniz.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="kv" style="margin-bottom: 18px;">
                    <div class="kv-row">
                        <span class="kv-key">İstek numarası</span>
                        <span class="kv-val num">@Model.RequestId</span>
                    </div>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
        </div>
    </div>
</div>
