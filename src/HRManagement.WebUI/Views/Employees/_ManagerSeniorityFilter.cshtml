@*
    Yönetici dropdown'ını çalışanın KENDİ ZİNCİRİNE süzer (otorite backend'de; bu UX):

      1) KIDEM: yönetici çalışandan kıdemce yüksek olmalı (data-seniority < seçilen
         kıdem; sayı küçüldükçe kıdem artar).

      2) KONUM — organizasyon modeline göre üç kademe:
         • GM  (data-seniority == 1) → şirket geneli, HER ZAMAN görünür.
         • GMY (data-unit boş)       → departman düzeyi; aynı departmandaysa görünür.
         • Müdür (data-unit dolu)    → BİRİM düzeyi; yalnızca aynı birimdeyse görünür.

         Böylece bir Kıdemli Uzman, departmandaki tüm müdürleri değil yalnızca
         KENDİ biriminin müdürünü + departmanının GMY'sini + GM'i görür.

         Geri düşüş: çalışanın birimi henüz seçilmemişse birim kısıtı uygulanmaz,
         departmandaki tüm müdürler listelenir. Birim seçilince liste daralır.

    Kıdemi/departmanı bilinmeyen aday süzülmez. "Yok (tepe)" seçeneği hep durur.
*@
<script>
    (function () {
        var seniority = document.getElementById('Seniority');
        var department = document.getElementById('DepartmentId');
        var unit = document.querySelector('[data-unit-select]');
        var manager = document.querySelector('[data-manager-select]');
        if (!manager || (!seniority && !department)) return;

        function apply() {
            var pickedSeniority = seniority ? parseInt(seniority.value, 10) : NaN;
            var pickedDept = department ? parseInt(department.value, 10) : NaN;

            // Boş birim "kısıt yok" demektir, 0 değil — parseInt('') NaN döner,
            // o yüzden null'a normalize ediyoruz.
            var rawUnit = unit ? unit.value : '';
            var pickedUnit = rawUnit === '' ? null : parseInt(rawUnit, 10);

            for (var i = 0; i < manager.options.length; i++) {
                var opt = manager.options[i];
                if (opt.value === '') { opt.hidden = false; continue; } // "Yok" hep dursun

                var s = parseInt(opt.getAttribute('data-seniority'), 10);
                var d = parseInt(opt.getAttribute('data-department'), 10);
                var uAttr = opt.getAttribute('data-unit');
                var u = (uAttr === null || uAttr === '') ? null : parseInt(uAttr, 10);

                // Kıdem: aday çalışandan kıdemce yüksek DEĞİLSE gizle (eşit/düşük).
                var hideBySeniority = !isNaN(pickedSeniority) && !isNaN(s) && s >= pickedSeniority;

                // Konum: GM (s === 1) departman/birim üstüdür, hiç süzülmez.
                var hideByPlace = false;
                if (s !== 1) {
                    if (!isNaN(pickedDept) && !isNaN(d) && d !== pickedDept) {
                        hideByPlace = true;                 // başka departman
                    } else if (u !== null && pickedUnit !== null && u !== pickedUnit) {
                        hideByPlace = true;                 // birim müdürü ama BAŞKA birimin
                    }
                }

                var hide = hideBySeniority || hideByPlace;
                opt.hidden = hide;
                if (hide && opt.selected) { manager.value = ''; } // geçersiz kalan seçimi düşür
            }
        }

        // Departman/kıdem değişiminde _UnitDepartmentFilter birim seçimini
        // PROGRAMATİK olarak sıfırlayabiliyor ve bu 'change' olayı tetiklemiyor.
        // Aynı olaya bağlı iki dinleyiciden hangisinin önce koşacağı kayıt sırasına
        // bağlı; setTimeout ile kuyruğa atarak süzmeyi HER ZAMAN o sıfırlamadan
        // sonra çalıştırıyoruz — yoksa eski birim değeriyle yanlış süzme yapardık.
        function scheduleApply() { setTimeout(apply, 0); }

        if (seniority) seniority.addEventListener('change', scheduleApply);
        if (department) department.addEventListener('change', scheduleApply);
        if (unit) unit.addEventListener('change', apply);

        apply();
    })();
</script>
