@using HRManagement.WebUI.Models
@model HRManagement.WebUI.Models.Api.Employees.EmployeeDetailResponse
@{
    var isOwnProfile = ViewData["IsOwnProfile"] is true;
    ViewData["Title"] = isOwnProfile ? "Profilim" : $"{Model.FirstName} {Model.LastName}";
    ViewData["Subtitle"] = isOwnProfile ? "Bilgilerin ve izin durumun." : "Çalışan künyesi, izin durumu ve ilişkileri.";

    if (!isOwnProfile)
    {
        ViewData["Crumb"] = (User.IsInRole("HR") || User.IsInRole("Admin")) ? "Çalışanlar" : "Ekibim";
        ViewData["CrumbUrl"] = Url.Action("Index", "Employees");
    }

    var fullName = $"{Model.FirstName} {Model.LastName}";
    var initials = $"{(Model.FirstName.Length > 0 ? Model.FirstName[0] : '?')}{(Model.LastName.Length > 0 ? Model.LastName[0] : ' ')}".Trim().ToUpperInvariant();

    // Pozisyon = (Birim varsa Birim, yoksa Departman) + Kıdem.
    var positionScope = string.IsNullOrWhiteSpace(Model.UnitName) ? Model.DepartmentName : Model.UnitName;
    var position = SeniorityDisplay.Position(positionScope, Model.Seniority);

    // İzin panelini GÖSTERME kararı API'den gelen açık yetkiye (CanSeeLeave) bağlıdır:
    // istekçi kendisi, İK/Admin ya da zincir yöneticisiyse görür. Sayının sıfır olup
    // olmamasından TAHMİN YÜRÜTÜLMEZ — böylece yetkili İK, bakiyesi 0 olan birini de görür.
    var canSeeLeave = Model.CanSeeLeave;
    var canEdit = User.IsInRole("HR") || User.IsInRole("Admin");
    var canWriteNote = User.IsInRole("HR") || User.IsInRole("Manager");
}

@functions {
    string DateText(DateTime d) => d.ToString("dd.MM.yyyy");

    // Yaş ve kıdem: doğum günü/yıldönümü henüz gelmediyse bir eksik sayılır.
    int FullYears(DateTime from, DateTime asOf)
    {
        var years = asOf.Year - from.Year;
        if (from.Date.AddYears(years) > asOf.Date) years--;
        return Math.Max(0, years);
    }

    string Init(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            : char.ToUpperInvariant(parts[0][0]).ToString();
    }
}

@section PageActions {
    @if (isOwnProfile)
    {
        <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            İzin talep et
        </a>
    }
    @if (canEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn">Düzenle</a>
    }
    @if (!isOwnProfile)
    {
        <a asp-action="Index" class="btn">Listeye dön</a>
    }
}

@* ── Kimlik kartı ──────────────────────────────────────────────────── *@
<section class="card card-pad-lg">
    <div class="row-center" style="gap: 20px;">
        <span class="avatar avatar-xl av-1">@initials</span>

        <div style="min-width: 240px;">
            <div class="row-tight" style="margin-bottom: 6px;">
                <h2 style="font-size: 20px; font-weight: 800; letter-spacing: -.5px;">@fullName</h2>
                <span class="badge badge-sm @(Model.IsActive ? "badge-ok" : "badge-neutral")">@(Model.IsActive ? "Aktif" : "Pasif")</span>
            </div>

            <div class="row-tight" style="margin-bottom: 6px; flex-wrap: wrap;">
                <span class="badge badge-sm badge-brand">@Model.DepartmentName</span>
                @if (!string.IsNullOrWhiteSpace(Model.UnitName))
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#b6bbc4" stroke-width="2.4" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    <span class="badge badge-sm badge-neutral">@Model.UnitName</span>
                }
            </div>

            <div class="page-sub">
                @(string.IsNullOrWhiteSpace(position) ? "—" : position) · @Model.Email
            </div>
        </div>

        <div class="mini-stats ml-auto">
            @if (canSeeLeave)
            {
                <div>
                    <div class="mini-stat-label">KALAN İZİN</div>
                    <div class="mini-stat-value @(Model.RemainingLeaveDays < 0 ? "text-danger-fg" : "text-ok")">@Model.RemainingLeaveDays</div>
                </div>
                <div>
                    <div class="mini-stat-label">HAK EDİLEN</div>
                    <div class="mini-stat-value">@Model.AccruedLeaveDays</div>
                </div>
                <div>
                    <div class="mini-stat-label">KULLANILAN</div>
                    <div class="mini-stat-value">@Model.UsedLeaveDays</div>
                </div>
            }
            <div>
                <div class="mini-stat-label">KIDEM</div>
                <div class="mini-stat-value">@FullYears(Model.HireDate, DateTime.Today)<span style="font-size: 12px; font-weight: 600; color: var(--muted-4);"> yıl</span></div>
            </div>
        </div>
    </div>
</section>

<div class="grid g-side">
    @* ── Sol sütun: künye + ilişkiler ──────────────────────────────── *@
    <div class="stack">
        <section class="card card-pad">
            <h2 class="section-title">Künye</h2>
            <div class="kv">
                <div class="kv-row">
                    <span class="kv-key">E-posta</span>
                    <span class="kv-val">@Model.Email</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">Telefon</span>
                    <span class="kv-val num">@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</span>
                </div>
                @* API bu alanı yalnızca İK'ya doldurur; null ise satır hiç yok. *@
                @if (!string.IsNullOrWhiteSpace(Model.NationalId))
                {
                    <div class="kv-row">
                        <span class="kv-key">T.C. kimlik no</span>
                        <span class="kv-val num">@Model.NationalId</span>
                    </div>
                }
                <div class="kv-row">
                    <span class="kv-key">Cinsiyet</span>
                    <span class="kv-val">@GenderDisplay.Label(Model.Gender)</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">Doğum tarihi</span>
                    <span class="kv-val num">@DateText(Model.BirthDate) <span class="text-muted">(@FullYears(Model.BirthDate, DateTime.Today))</span></span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">İşe giriş</span>
                    <span class="kv-val num">@DateText(Model.HireDate)</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">Departman</span>
                    <span class="kv-val">@Model.DepartmentName</span>
                </div>
                @* Birim opsiyonel: GM/GMY gibi yalnızca departmana bağlı kişilerde satır hiç yok. *@
                @if (!string.IsNullOrWhiteSpace(Model.UnitName))
                {
                    <div class="kv-row">
                        <span class="kv-key">Birim</span>
                        <span class="kv-val">@Model.UnitName</span>
                    </div>
                }
                <div class="kv-row">
                    <span class="kv-key">Kıdem seviyesi</span>
                    <span class="kv-val">@SeniorityDisplay.Label(Model.Seniority)</span>
                </div>
            </div>

            <div class="divider"></div>

            @if (Model.ManagerId is int managerId && Model.ManagerFullName is not null)
            {
                <a class="row-center" style="gap: 12px; flex-wrap: nowrap; color: inherit;"
                   asp-action="Details" asp-route-id="@managerId">
                    <span class="avatar avatar-md av-2">@Init(Model.ManagerFullName)</span>
                    <div class="flex-1">
                        <div class="mini-stat-label" style="margin-bottom: 2px;">YÖNETİCİ</div>
                        <div class="dt-primary">@Model.ManagerFullName</div>
                    </div>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b6bbc4" stroke-width="2.2" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                </a>
            }
            else
            {
                <div>
                    <div class="mini-stat-label" style="margin-bottom: 2px;">YÖNETİCİ</div>
                    <div class="dt-cell-muted">— (zincirin en üstü)</div>
                </div>
            }
        </section>

        @* ── Doğrudan ekibi ────────────────────────────────────────── *@
        @if (Model.DirectReports.Any())
        {
            <section class="card card-flush">
                <div class="card-head">
                    <h2>Doğrudan ekibi</h2>
                    <span class="card-head-meta">@Model.DirectReports.Count kişi</span>
                </div>
                @for (var i = 0; i < Model.DirectReports.Count; i++)
                {
                    var m = Model.DirectReports[i];
                    <a class="dt-row" style="--cols: 1fr auto auto;" asp-action="Details" asp-route-id="@m.Id">
                        <div class="person">
                            <span class="avatar avatar-sm av-@(i % 6 + 1)">@Init(m.FullName)</span>
                            <div class="person-text">
                                <div class="dt-primary">@m.FullName</div>
                            </div>
                        </div>
                        <span class="dt-secondary">@SeniorityDisplay.Label(m.Seniority)</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b6bbc4" stroke-width="2.2" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    </a>
                }
            </section>
        }
    </div>

    @* ── Sağ sütun: izin, notlar, mentorluk ────────────────────────── *@
    <div class="stack">
        @if (canSeeLeave)
        {
            <section class="card card-flush">
                <div class="card-head">
                    @* Kendi profilinde başlık kişiseldir; "Tüm kayıtlar" da mine=true ile
                       kişisel görünüme gider — HR'ı şirket geneli İzin Geçmişi'ne atmaz.
                       (mine, HR dışı rollerde etkisiz: onlar zaten kendini görür.) *@
                    <h2>@(isOwnProfile ? "Kendi İzin Geçmişim" : "İzin geçmişi")</h2>
                    @if (isOwnProfile)
                    {
                        <a class="card-head-link" asp-controller="LeaveRequests" asp-action="Index" asp-route-mine="true">Tüm kayıtlarım</a>
                    }
                    else
                    {
                        <a class="card-head-link" asp-controller="LeaveRequests" asp-action="Index">Tüm kayıtlar</a>
                    }
                </div>

                @if (Model.RecentLeaveRequests.Any())
                {
                    <div class="dt" style="--cols: 1fr 1.2fr .5fr auto;">
                        <div class="dt-head">
                            <span>Tür</span><span>Tarih</span><span class="text-right">Gün</span><span style="padding-left: 14px;">Durum</span>
                        </div>
                        @foreach (var leave in Model.RecentLeaveRequests)
                        {
                            var (badge, statusText) = LeaveDisplay.StatusBadgeShort(leave.Status);
                            <a class="dt-row" asp-controller="LeaveRequests" asp-action="Details" asp-route-id="@leave.Id">
                                <span><span class="badge badge-sm @LeaveDisplay.TypeBadge(leave.Type)">@LeaveDisplay.TypeText(leave.Type)</span></span>
                                <span class="dt-cell num">@DateText(leave.StartDate) – @DateText(leave.EndDate)</span>
                                <span class="dt-strong text-right">@leave.TotalDays</span>
                                <span style="padding-left: 14px;">
                                    @* Açıklamayı API yalnızca kendisi/İK/Admin'e gönderir. *@
                                    <span class="badge badge-sm @badge" title="@leave.Description">@statusText</span>
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty">
                        <div class="empty-title">İzin kaydı yok</div>
                        <div class="empty-text">@(isOwnProfile ? "Henüz izin talebin bulunmuyor." : "Bu çalışanın izin kaydı bulunmuyor.")</div>
                    </div>
                }
            </section>
        }

        @* ── Notlar (§5.2): API null gönderdiyse istekçi göremez — panel hiç yok.
             Kişi kendi profilinde kendi notlarını GÖRMEZ; İK/Admin/yetkili Manager görür. *@
        @if (Model.Notes is not null)
        {
            <section class="card card-flush">
                <div class="card-head">
                    <div class="row-tight">
                        <h2>İK notları</h2>
                        <span class="badge badge-sm badge-warn">Çalışan göremez</span>
                    </div>
                    <span class="card-head-meta">@Model.Notes.Count not</span>
                </div>

                @for (var i = 0; i < Model.Notes.Count; i++)
                {
                    var note = Model.Notes[i];
                    <div class="note">
                        <span class="avatar avatar-sm av-@(i % 6 + 1)">@Init(note.AuthorName)</span>
                        <div class="flex-1">
                            <div class="note-head">
                                <span class="note-author">@note.AuthorName</span>
                                <span class="note-date">@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div class="note-text">@note.Content</div>
                        </div>
                    </div>
                }

                @if (!Model.Notes.Any())
                {
                    <div class="empty">
                        <div class="empty-title">Henüz not girilmemiş</div>
                        <div class="empty-text">Notlar yalnızca İK ve yetkili yöneticiler tarafından görülür.</div>
                    </div>
                }

                @* Girme yetkisi İK + (kendi ekibi için) Manager'dadır; Admin okur, yazamaz. *@
                @if (canWriteNote)
                {
                    <form asp-action="AddNote" asp-route-id="@Model.Id" method="post"
                          style="padding: 14px 18px; display: flex; gap: 10px; align-items: center; border-top: 1px solid var(--line-3);">
                        @Html.AntiForgeryToken()
                        <input type="text" name="content" class="input" maxlength="1000"
                               placeholder="İK notu ekle — çalışan göremez" required />
                        <button type="submit" class="btn btn-primary btn-md">Kaydet</button>
                    </form>
                }
            </section>
        }

        @* ── Mentorluk verdiği stajyerler ──────────────────────────── *@
        @if (Model.MentoredInterns.Any())
        {
            <section class="card card-flush">
                <div class="card-head">
                    <div class="row-tight">
                        <h2>Mentorluk verdiği stajyerler</h2>
                        <span class="badge badge-sm badge-violet">@Model.MentoredInterns.Count</span>
                    </div>
                </div>
                @for (var i = 0; i < Model.MentoredInterns.Count; i++)
                {
                    var intern = Model.MentoredInterns[i];
                    @* Stajyer detayına (görevler + notlar) gider. Mentor ve İK/Admin
                       açabilir; yetkisiz izleyici API'den nazik bir retle döner. *@
                    <a class="dt-row" style="--cols: 1.3fr 1fr auto;"
                       asp-controller="Mentorship" asp-action="Detail" asp-route-id="@intern.Id">
                        <div class="person">
                            <span class="avatar avatar-sm av-3">@Init(intern.FullName)</span>
                            <div class="person-text">
                                <div class="dt-primary">@intern.FullName</div>
                                <div class="dt-secondary">@intern.University</div>
                            </div>
                        </div>
                        <span class="dt-cell-muted num">@DateText(intern.StartDate) – @DateText(intern.EndDate)</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b6bbc4" stroke-width="2.2" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    </a>
                }
            </section>
        }
    </div>
</div>
