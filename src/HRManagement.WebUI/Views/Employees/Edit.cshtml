@model HRManagement.WebUI.Models.Employees.EmployeeFormViewModel
@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName} · Düzenle";
    ViewData["Subtitle"] = $"#{Model.Id} numaralı kayıt. Değişiklikler kaydedildiğinde iş kuralları API'de yeniden doğrulanır.";
    ViewData["Crumb"] = "Çalışanlar";
    ViewData["CrumbUrl"] = Url.Action("Index", "Employees");

    var formData = new ViewDataDictionary(ViewData);
    formData["IsCreate"] = false;
}

@section PageActions {
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn">Profili gör</a>
}

<div class="card card-pad-lg mid">
    <form asp-action="Edit" method="post" novalidate>
        <partial name="_EmployeeForm" model="Model" view-data="formData" />

        <div class="form-actions" style="margin-top: 22px;">
            <button type="submit" class="btn btn-primary btn-lg">Güncelle</button>
            <a asp-action="Index" class="btn btn-lg">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ManagerSeniorityFilter" />
    <partial name="_UnitDepartmentFilter" />
}
