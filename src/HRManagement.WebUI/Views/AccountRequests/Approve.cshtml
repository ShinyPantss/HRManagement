@model HRManagement.WebUI.Models.AccountRequests.ApproveAccountRequestViewModel
@{
    ViewData["Title"] = "Hesap Aç";
    ViewData["Subtitle"] = $"{Model.SubjectType}: {Model.SubjectName} · kıdemden türetilen rol: {Model.SuggestedRole}";
    ViewData["Crumb"] = "Bekleyen Talepler";
    ViewData["CrumbUrl"] = Url.Action("Pending", "AccountRequests");
}

<div class="card card-pad-lg narrow">
    <form asp-action="Approve" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SubjectName" />
        <input type="hidden" asp-for="SubjectType" />
        <input type="hidden" asp-for="SuggestedRole" />

        <div class="callout" style="margin-bottom: 22px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v5M12 16.5h.01" /><circle cx="12" cy="12" r="9" /></svg>
            <div class="callout-text">
                Kullanıcı adı, e-posta ve geçici şifre şirket standardında önceden dolduruldu.
                Değiştirebilirsin; şifreyi kullanıcıya ilet, ilk girişte değiştirmesini iste.
            </div>
        </div>

        <div class="stack">
            <div class="form-grid">
                <div class="field">
                    <label class="field-label" asp-for="Username"></label>
                    <input asp-for="Username" class="input" autocomplete="off" />
                    <span asp-validation-for="Username"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Email"></label>
                    <input asp-for="Email" class="input" autocomplete="off" />
                    <span asp-validation-for="Email"></span>
                </div>
            </div>

            <div class="field">
                <label class="field-label" asp-for="Password"></label>
                <input asp-for="Password" type="text" class="input" autocomplete="off" />
                <span class="field-hint">Otomatik üretildi; kullanıcıya iletin, ilk girişte değiştirmeli.</span>
                <span asp-validation-for="Password"></span>
            </div>

            @* Rol override (yalnızca Admin bu ekrana girer): genelde boş bırakılır ve
               talebin otomatik türetilmiş rolü kullanılır. İK/Admin gibi kıdemden
               türetilemeyen roller için elle seçilir — ör. İK Müdürü için "İK (HR)". *@
            <div class="field">
                <label class="field-label" asp-for="Role"></label>
                <select asp-for="Role" asp-items="Model.RoleOptions" class="select">
                    <option value="">Otomatik rolü kullan (@Model.SuggestedRole)</option>
                </select>
                <span class="field-hint">
                    Boş = otomatik rol. İK/Admin gibi türetilemeyen roller için seçin (ör. İK Müdürü → İK).
                </span>
                <span asp-validation-for="Role"></span>
            </div>
        </div>

        <div class="form-actions" style="margin-top: 22px;">
            <button type="submit" class="btn btn-primary btn-lg">Onayla ve hesabı aç</button>
            <a asp-action="Pending" class="btn btn-lg">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
